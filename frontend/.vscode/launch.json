{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Keebox (debug)",
      "templateFor": "",
      "type": "dart",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "program": "${workspaceFolder}/lib/main.dart",
      "flutterMode": "debug",
      "toolArgs": ["--dart-define=API_BASE_URL=http://192.168.1.66:8000/api"]
    },
    {
      "name": "Keebox (profile)",
      "type": "dart",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "program": "${workspaceFolder}/lib/main.dart",
      "flutterMode": "profile",
      "toolArgs": ["--dart-define=API_BASE_URL=http://192.168.1.66:8000/api"]
    },
    {
      "name": "Keebox (release)",
      "type": "dart",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "program": "${workspaceFolder}/lib/main.dart",
      "flutterMode": "release",
      "toolArgs": ["--dart-define=API_BASE_URL=http://192.168.1.66:8000/api"]
    }
  ]
}
